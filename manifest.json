{
  "schemaVersion": 1,
  "id": "vstoms.netbird",
  "name": "NetBird",
  "version": "2.0.0",
  "author": "Viggo Stomsvik",
  "license": "MIT",
  "description": "NetBird status, connection control, network selection, peer browsing, and quick actions for the Omarchy bar.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "NetBird",
    "description": "Toggle NetBird, inspect your connection, browse peers, select networks, copy addresses, SSH, and ping.",
    "category": "Network",
    "aliases": ["netbird", "vpn"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30,
      "showDisconnectedPeers": true,
      "showNetworks": true,
      "monochromeIcon": true,
      "adminConsoleUrl": "https://app.netbird.io/"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "showDisconnectedPeers",
        "type": "boolean",
        "label": "Show disconnected peers",
        "defaultValue": true
      },
      {
        "key": "showNetworks",
        "type": "boolean",
        "label": "Show networks and resources",
        "defaultValue": true
      },
      {
        "key": "monochromeIcon",
        "type": "boolean",
        "label": "Match icon to bar color",
        "description": "Draw the NetBird mark in the bar's foreground color like other bar icons. Turn off to use the brand colors.",
        "defaultValue": true
      },
      {
        "key": "adminConsoleUrl",
        "type": "string",
        "label": "Admin console URL",
        "defaultValue": "https://app.netbird.io/"
      }
    ]
  }
}
